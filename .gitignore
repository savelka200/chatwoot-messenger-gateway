```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
.env
.env.local
*.env.*

# Logs
*.log

# Temporary files
*.tmp
*.swp

# IDE specific
.vscode/
.idea/

# Build artifacts
dist/
build/
target/
*.o
*.obj
*.out

# Dependencies
node_modules/
.mypy_cache/
.pytest_cache/
.coverage
coverage/
htmlcov/

# OS generated files
.DS_Store
Thumbs.db
```